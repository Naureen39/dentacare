{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import button %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:22px;color:#0B2545;">Reset your password</h1>
<p>We received a request to reset the password for your account.</p>
<p>{{ button(action_url, "Choose a new password") }}</p>
<p style="color:#475569;font-size:13px;">The link is valid for {{ minutes }} minutes and can be used once. If the button does not work, copy this address into your browser:<br>{{ action_url }}</p>
<p style="color:#475569;font-size:13px;">If you did not request this, you can ignore this message.</p>
{% endblock %}

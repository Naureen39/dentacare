{% extends "_base.html.j2" %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:22px;color:#0B2545;">Your verification code</h1>
<p>Hello {{ first_name }},</p>
<p>Enter this code on the booking page to confirm your appointment request:</p>
<p style="font-size:32px;letter-spacing:6px;font-weight:bold;color:#0B2545;margin:16px 0;">{{ code }}</p>
<p style="color:#475569;font-size:13px;">Your verification code is {{ code }}. It is valid for {{ minutes }} minutes. If you did not request it, you can ignore this message.</p>
{% endblock %}

# Copy to .env and adjust. Never commit real keys.
ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian
POSTGRES_DB=meridian
DATABASE_URL=postgresql+asyncpg://meridian:meridian@localhost:5432/meridian
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-development-only
JWT_ACCESS_MINUTES=15
REFRESH_DAYS=14
FIELD_ENCRYPTION_KEY=
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PRIMARY=groq
EMBED_MODEL=BAAI/bge-small-en-v1.5

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

CLINIC_TZ=America/New_York
CLINIC_NAME=Meridian Dental Care

# Production profile only: public host name served by Caddy.
SITE_ADDRESS=localhost

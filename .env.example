# Copy to .env and adjust. Never commit real keys.
ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian
POSTGRES_DB=meridian
DATABASE_URL=postgresql+asyncpg://meridian:meridian@127.0.0.1:5432/meridian
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-development-only
JWT_ACCESS_MINUTES=15
REFRESH_DAYS=14
# Generate with: cd backend && uv run python -m scripts.generate_encryption_key k1
# Empty is allowed outside production (a development key is derived from JWT_SECRET).
FIELD_ENCRYPTION_KEY=
# Previous keys kept readable after rotation, comma separated, same format.
FIELD_ENCRYPTION_OLD_KEYS=
PUBLIC_BASE_URL=http://localhost:5173
# Addresses trusted to set X-Forwarded-For (the reverse proxy). Rate limits use the client IP.
FORWARDED_ALLOW_IPS=127.0.0.1
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PRIMARY=groq
# Seconds to wait for a provider before moving to the other one.
LLM_TIMEOUT_SECONDS=8
# Extra completion tokens for models that count hidden reasoning (gpt-oss).
GROQ_REASONING_HEADROOM=100
# 0 turns Gemini thinking off; use -1 to leave the model default.
GEMINI_THINKING_BUDGET=0
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Where downloaded model files are kept, and where the knowledge base files live.
EMBED_CACHE_DIR=models
KB_DIR=../data/kb
INTENTS_FILE=../data/intents.yaml

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

CLINIC_TZ=America/New_York
CLINIC_NAME=Meridian Dental Care
CLINIC_ADDRESS=1200 Harbor View Drive, Suite 300, Springfield, NY 10001
CLINIC_PHONE=(555) 010-0199
CLINIC_EMAIL=frontdesk@meridian.test
MAIL_FROM=no-reply@meridian.test

# Production profile only: public host name served by Caddy.
SITE_ADDRESS=localhost

# Shown in the emergency message of the chat assistant.
CLINIC_EMERGENCY_PHONE=(555) 010-0911
# Where trained analytics models (the no show model) are saved.
MODEL_DIR=models/analytics
